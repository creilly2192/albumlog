---
import { readAlbums, readNowId } from "../lib/data";
import { Play } from "@lucide/astro";
import { formatReleaseText } from "../lib/releasedYear";

import BaseLayout from "../layouts/BaseLayout.astro";

const albums = readAlbums();
const nowId = readNowId();

const album = nowId ? albums.find((a) => a.id === nowId) : null;
const missing = nowId && !album;
const releasedText = formatReleaseText(album);
---

<BaseLayout title="Now Listening">
    {
        album ? (
            <>
                <div class="now-listening__album-container">
                    <div class="now-listening__album-meta">
                        <span class="now-listening__label overline">
                            Now Listening
                        </span>
                        <h1 class="now-listening__album">
                            {album.title
                                .split(" ")
                                .map((word, i) =>
                                    i === 1 ? <em>{word} </em> : word + " ",
                                )}
                        </h1>
                        <h2 class="now-listening__artist">
                            <span>by</span>
                            {album.artist}
                        </h2>

                        <div class="now-listening__meta-stats">
                            <div class="now-listening__released">
                                <p class="now-listening__meta-stats-label">
                                    Released
                                </p>
                                <p>{releasedText}</p>
                            </div>

                            {album.ranks ? (
                                <div class="album__ranks">
                                    <p class="now-listening__meta-stats-label">
                                        Ranking
                                    </p>
                                    {album.ranks?.rollingstone ? (
                                        <span class="album__rank">
                                            Rolling Stone №{" "}
                                            <span>
                                                {" "}
                                                {album.ranks.rollingstone}
                                            </span>
                                        </span>
                                    ) : null}
                                    {album.ranks?.apple ? (
                                        <span class="album__rank">
                                            № <span> {album.ranks.apple}</span>
                                        </span>
                                    ) : null}
                                </div>
                            ) : null}
                        </div>
                    </div>

                    <div class="now-listening__album-cover"> </div>
                </div>
            </>
        ) : missing ? (
            <>
                <p>
                    Pinned album id <code>{nowId}</code> wasn’t found in{" "}
                    <code>data/albums.json</code>.
                </p>
                <p>
                    Run <code>npm run albums:build</code> (then commit) or
                    repick.
                </p>
            </>
        ) : (
            <>
                <p>No pinned album yet (or it’s invalid).</p>
                <p>
                    Run <code>npm run pick:album</code> locally to generate{" "}
                    <code>data/now.json</code>.
                </p>
            </>
        )
    }
</BaseLayout>
