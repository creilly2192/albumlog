---
import { getNowPlayingAlbum } from "../lib/db";
import { formatReleaseText } from "../lib/releasedYear";
import BaseLayout from "../layouts/BaseLayout.astro";

const album = await getNowPlayingAlbum(Astro.locals.supabase);
const releasedText = album ? formatReleaseText(album) : null;
---

<BaseLayout title="Now Listening">
    {
        album ? (
            <>
                <div class="now-listening__album-container">
                    <div class="now-listening__album-meta">
                        <span class="now-listening__label overline">
                            Now Listening
                        </span>
                        <h1 class="now-listening__album">
                            {album.title
                                .split(" ")
                                .map((word, i) =>
                                    i === 1 ? <span>{word} </span> : word + " ",
                                )}
                        </h1>
                        <h2 class="now-listening__artist">
                            <span>by</span>
                            {album.artist}
                        </h2>

                        <div class="now-listening__meta-stats">
                            <div class="now-listening__released">
                                <p class="now-listening__meta-stats-label">
                                    Released
                                </p>
                                <p>{releasedText}</p>
                            </div>

                            {(album.rank_rs || album.rank_apple) ? (
                                <div class="album__ranks">
                                    <p class="now-listening__meta-stats-label">
                                        Ranking
                                    </p>
                                    {album.rank_rs ? (
                                        <span class="album__rank">
                                            Rolling Stone №{" "}
                                            <span>{album.rank_rs}</span>
                                        </span>
                                    ) : null}
                                    {album.rank_apple ? (
                                        <span class="album__rank">
                                            Apple № <span>{album.rank_apple}</span>
                                        </span>
                                    ) : null}
                                </div>
                            ) : null}
                        </div>
                    </div>

                    <div class="now-listening__album-cover"> </div>
                </div>
            </>
        ) : (
            <p>No album queued. Set one in the now_playing table.</p>
        )
    }
</BaseLayout>
