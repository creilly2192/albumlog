---
import BaseLayout from "../layouts/BaseLayout.astro";
import { readAlbums } from "../lib/data";

import AlbumListItem from "../components/AlbumListItem.astro";

const albums = readAlbums();

const favorites = albums
  .filter((a: { favorite: boolean }) => a.favorite === true)
  .sort(
    (
      a: { listenedAt: string | number | Date },
      b: { listenedAt: string | number | Date },
    ) => {
      const ad = a.listenedAt ? new Date(a.listenedAt).getTime() : 0;
      const bd = b.listenedAt ? new Date(b.listenedAt).getTime() : 0;
      return bd - ad;
    },
  );
---

<BaseLayout title="Favorites">
  <div class="section-heading">
    <span class="section-heading__label">Favourites — a short list</span>
    <h1 class="display">
      The ones I'll keep on <span>repeat</span>.
    </h1>
  </div>

  {
    favorites.length === 0 ? (
      <p>No favorites yet.</p>
    ) : (
      <ul class="listening-log__list listening-log__list--favorites">
        {favorites.map((a: unknown) => (
          <AlbumListItem album={a} />
        ))}
      </ul>
    )
  }
</BaseLayout>
