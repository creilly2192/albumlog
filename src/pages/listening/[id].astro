---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getRatingMeta } from "../../lib/rating";
import { getTapeColor } from "../../lib/genres";

export const prerender = false;

const { id } = Astro.params;

const [{ data: album }, { data: log }] = await Promise.all([
  Astro.locals.supabase.from("albums").select("*").eq("id", id!).maybeSingle(),
  Astro.locals.supabase
    .from("logs")
    .select("*")
    .eq("album_id", id!)
    .eq("user_id", import.meta.env.PUBLIC_OWNER_USER_ID)
    .maybeSingle(),
]);

if (!album) return Astro.redirect("/log");

const tapeColor = getTapeColor(album.genres);
const ratingMeta = getRatingMeta(log?.rating ?? null);
const genre = album.genres?.[0] ?? "";

const listenedAtFull = log?.date_listened
  ? new Intl.DateTimeFormat("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(new Date(`${log.date_listened}T00:00:00`))
  : null;

type FavoriteTrack = { track_name: string; note: string };
const favoriteTracks: FavoriteTrack[] = log?.favorite_tracks ?? [];
const standoutTracks: string[] = log?.standout_tracks ?? [];

const favoriteMap = new Map(favoriteTracks.map((t) => [t.track_name, t.note]));
---

<BaseLayout title={`${album.title} — ${album.artist}`}>
  <a href="/log" class="album-detail__back">← BACK TO LOG</a>

  <div class="album-detail__hero">
    <div class="album-detail__cassette" style={`--tape-color: ${tapeColor}`}>
      <div class="album-detail__cassette-window"></div>
      <div class="album-detail__cassette-reels">
        <div class="album-detail__cassette-reel"></div>
        <div class="album-detail__cassette-reel"></div>
      </div>
    </div>

    <div class="album-detail__info">
      <p class="album-detail__genre-year" style={`--tape-color: ${tapeColor}`}>
        {genre}<span class="album-detail__dot"> · </span>{album.year}
      </p>
      <h1 class="album-detail__title">{album.title}</h1>
      <p class="album-detail__artist">{album.artist}</p>

      {
        (album.rank_rs || album.rank_apple) && (
          <div class="album-detail__ranks">
            {album.rank_rs && (
              <span class="album-detail__rank album-detail__rank--rs">#{album.rank_rs} Rolling Stone</span>
            )}
            {album.rank_apple && (
              <span class="album-detail__rank album-detail__rank--apple">#{album.rank_apple} Apple</span>
            )}
          </div>
        )
      }

      {
        (ratingMeta.label || listenedAtFull) && (
          <div class="album-detail__rating-row" style={`--tape-color: ${tapeColor}`}>
            {ratingMeta.label && (
              <span class="album-detail__rating-badge">{ratingMeta.label}</span>
            )}
            {listenedAtFull && (
              <span class="album-detail__heard">Heard {listenedAtFull}</span>
            )}
          </div>
        )
      }

      {
        log?.notes && (
          <blockquote class="album-detail__notes">
            &ldquo;{log.notes}&rdquo;
          </blockquote>
        )
      }
    </div>
  </div>

  {
    standoutTracks.length > 0 && (
      <div class="album-detail__tracks-section">
        <p class="album-detail__tracks-label">Standout Tracks</p>
        <ul class="album-detail__tracks-grid">
          {standoutTracks.map((trackName: string) => {
            const note = favoriteMap.get(trackName);
            const isFavorite = favoriteMap.has(trackName);
            return (
              <li
                class={`album-detail__track-card${isFavorite ? " album-detail__track-card--favorite" : ""}`}
                style={`--tape-color: ${tapeColor}`}
              >
                <span class="album-detail__track-name">{trackName}</span>
                {note && (
                  <em class="album-detail__track-note">{note}</em>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    )
  }
</BaseLayout>
