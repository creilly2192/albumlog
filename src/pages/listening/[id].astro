---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { readAlbums } from "../../lib/data";
import { formatReleaseText, formatListenedAt } from "../../lib/releasedYear";
import { getRatingMeta } from "../../lib/rating";

export async function getStaticPaths() {
  const albums = readAlbums();

  return albums.map((album) => ({
    params: { id: album.id },
    props: { album },
  }));
}

const { album } = Astro.props;
const releasedText = formatReleaseText(album);
const listenedAtText = formatListenedAt(album.listenedAt);
const ratingMeta = getRatingMeta(album.rating);
---

<BaseLayout title={`${album.title} — ${album.artist}`}>
  <div class="album-details__grid">
    <div class="album-details__left">
      <h1 class="album-details__album">{album.title
                                .split(" ")
                                .map((word, i) =>
                                    i === 1 ? <em>{word} </em> : word + " ",
                                )}</h1>
      <p class="album-details__artist">{album.artist}, {album.year}</p>
    
      <div class="album-details__meta">
        <div>
          <span class="album-details__label">Listened</span>

          {
            listenedAtText ? (
              <span class="album-details__listened-at">{listenedAtText}</span>
            ) : null
          }
        </div>
        <div class="album__personal-rating">
          <span class="album-details__label">My Rating</span>
          <div
              class="album-details__ratings"
              style={`--rating-color: ${ratingMeta.color};`}
            >
              <span class="album-details__rating">
                {ratingMeta.label}
              </span>
            </div>
        </div>

        {
          album.ranks ? (
            <div class="album__ranks">
              <span class="album-details__label">Index</span>
              {album.ranks?.rollingstone ? (
                <span class="album__rank">
                  Rolling Stone #{album.ranks.rollingstone}
                </span>
              ) : null}
              {album.ranks?.apple ? (
                <span class="album__rank">
                  Apple #{album.ranks.apple}
                </span>
              ) : null}
            </div>
          ) : null
        }

      </div>
              

    </div>

    <div class="album-details__right">
      {
    album.standoutTracks && album.standoutTracks.length ? (
      <h4 class="album-details__tracks-label">Standout Tracks</h4>
      <div class="album-details__standout-tracks-container">
        <ol class="album-details__standout-tracks">
        {album.standoutTracks.map((track) => (
          <li>
            {track}
            {album.favoriteTracks?.includes(track) && (
              <span class="album-details__favorite-track">a perfect song</span>
            )}
          </li>
        ))}
        </ol>
      </div>
    ) : (
      <p>No standout tracks listed.</p>
    )
  }
    </div>
  </div>
  

  

  

  
  <!-- <h4 class="album-details__heading">Notes</h4>
  <div class="album-details__notes">
    <p>{album.notes}</p>
  </div> -->

</BaseLayout>
