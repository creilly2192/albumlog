---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAlbumsWithLogs } from "../lib/db";
import AlbumListItem from "../components/AlbumListItem.astro";

function formatMonthYear(iso: string) {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  return new Intl.DateTimeFormat("en-US", { month: "long", year: "numeric" }).format(d);
}

function parseDate(s: string) {
  return new Date(`${s}T00:00:00`);
}

const albums = await getAlbumsWithLogs(Astro.locals.supabase);

const listened = albums
  .filter((a) => a.log?.date_listened != null)
  .sort((a, b) =>
    parseDate(b.log!.date_listened!).getTime() -
    parseDate(a.log!.date_listened!).getTime()
  );

const groups: Record<string, { label: string; items: typeof listened; sortValue: number }> = {};

for (const a of listened) {
  const d = parseDate(a.log!.date_listened!);
  const key = `${d.getFullYear()}-${d.getMonth()}`;
  if (!groups[key]) {
    groups[key] = {
      label: formatMonthYear(a.log!.date_listened!),
      items: [],
      sortValue: new Date(d.getFullYear(), d.getMonth(), 1).getTime(),
    };
  }
  groups[key].items.push(a);
}

const sortedGroups = Object.values(groups).sort((a, b) => b.sortValue - a.sortValue);
---

<BaseLayout title="Listening Log">
  <div class="section-heading section-heading--grid">
    <h1 class="display">
      What I've been <span>listening</span> to
    </h1>
    <p>A ledger of every album I've listened to this year from this project.</p>
  </div>

  {
    sortedGroups.length === 0 ? (
      <p>Nothing logged yet.</p>
    ) : (
      sortedGroups.map((group) => (
        <section class="listening-log__group">
          <div class="listening-log__group-header">
            <h2 class="listening-log__month">{group.label}</h2>
            <span class="listening-log__month-count">
              {group.items.length} albums
            </span>
          </div>
          <ul class="listening-log__list">
            {group.items.map((a) => {
              return <AlbumListItem album={a} />;
            })}
          </ul>
        </section>
      ))
    )
  }
</BaseLayout>
