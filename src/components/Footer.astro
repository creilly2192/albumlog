---
const { pathname } = Astro.url;
const isLoggedIn = !!Astro.locals.session;
---

<footer class="site-footer">
    <div class="container">
        <div class="footer__top">
            <div class="footer__top-left">
                <div>
                    <span class="footer__site-title">
                        Album <span class="footer__site-title-highlight"
                            >Log</span
                        >
                    </span>
                </div>
            </div>

            <div class="footer__column">
                <span class="footer__column-label">Index</span>
                <li>
                    <a href="/">Now Listening</a>
                </li>
                {
                    isLoggedIn && (
                        <li>
                            <a href="/pick-next">Pick Next</a>
                        </li>
                    )
                }
                <li>
                    <a href="/log">Log</a>
                </li>
            </div>

            <div class="footer__column">
                <span class="footer__column-label">Sources</span>
                <li>
                    <a
                        target="_blank"
                        href="https://www.rollingstone.com/music/music-lists/best-albums-of-all-time-1062063/arcade-fire-%ef%bb%bffuneral-1062733/"
                        >Rolling Stone</a
                    >
                </li>
                <li>
                    <a target="_blank" href="https://100best.music.apple.com/us"
                        >Apple 100</a
                    >
                </li>
                <li>
                    <a href="#">Personal Shelf</a>
                </li>
            </div>
        </div>

        <div class="footer__bottom">
            <p>
                Made by <a href="https://christinareilly.com">Christina</a>. ©
                2026.
            </p>
            {isLoggedIn && <a href="/api/auth/signout">Sign Out</a>}
        </div>
    </div>
</footer>
