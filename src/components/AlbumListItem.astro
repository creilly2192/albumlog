---
const { album } = Astro.props;

import { getRatingMeta } from "../lib/rating";
import { formatReleaseText } from "../lib/releasedYear";

const ratingMeta = getRatingMeta(album.log?.rating ?? null);
const releasedText = formatReleaseText(album);
---

<li class="listening-log__item">
    <div class="listening-log__item-wrapper">
        <div class="listening-log__item-content">
            <div class="listening-log__album-details">
                <div class="listening-log__album">
                    <span class="listening-log__release">{releasedText}</span>
                    <a
                        class="listening-log__title"
                        href={`/listening/${album.id}`}
                    >
                        {album.title}
                    </a>
                    <span class="listening-log__artist">{album.artist}</span>
                </div>

                <div class="listening-log__meta">
                    <div
                        class="listening-log__ratings"
                        style={`--rating-color: ${ratingMeta.color};`}
                    >
                        <span class="listening-log__rating">
                            &mdash; {ratingMeta.label}
                        </span>
                    </div>

                    <div class="listening-log__rankings">
                        {
                            album.rank_rs ? (
                                <span class="listening-log__ranking">
                                    #{album.rank_rs} Rolling Stone
                                </span>
                            ) : null
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</li>
