---
import "../styles/cassette-player.css";
---

<div class="cassette-player" data-dc-tpl="38">
    <svg
        data-dc-tpl="39"
        viewBox="0 0 680 420"
        width="440"
        height="271"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="none"
        class="cassette-player__svg"
    >
        <defs data-dc-tpl="40">
            <radialGradient
                data-dc-tpl="41"
                id="hubGmain"
                cx="0.35"
                cy="0.3"
                r="0.8"
            >
                <stop data-dc-tpl="42" offset="0" stop-color="#4a4560"></stop>
                <stop data-dc-tpl="43" offset="1" stop-color="#1c1a24"></stop>
            </radialGradient>
            <linearGradient
                data-dc-tpl="44"
                id="tapeGmain"
                x1="0"
                y1="0"
                x2="1"
                y2="0"
            >
                <stop data-dc-tpl="45" offset="0" stop-color="#0a090c"></stop>
                <stop data-dc-tpl="46" offset="0.5" stop-color="#4a4750"></stop>
                <stop data-dc-tpl="47" offset="1" stop-color="#0a090c"></stop>
            </linearGradient>
        </defs>

        <rect
            data-dc-tpl="48"
            x="10"
            y="10"
            width="660"
            height="400"
            rx="28"
            fill="#211f2a"
            stroke="#423e52"
            stroke-width="2"></rect>
        <g data-dc-tpl="49" fill="#3a3550">
            <circle data-dc-tpl="50" cx="46" cy="46" r="10"></circle><circle
                data-dc-tpl="51"
                cx="634"
                cy="46"
                r="10"></circle>
            <circle data-dc-tpl="52" cx="46" cy="374" r="10"></circle><circle
                data-dc-tpl="53"
                cx="634"
                cy="374"
                r="10"></circle>
        </g>

        <rect
            data-dc-tpl="54"
            x="76"
            y="58"
            width="528"
            height="278"
            rx="16"
            fill="#e9e2d3"
            opacity="0.94"></rect>
        <path
            data-dc-tpl="55"
            d="M76 196 H604 V320 A16 16 0 0 1 588 336 H92 A16 16 0 0 1 76 320 Z"
            fill="#ff5d99"></path>

        <rect
            data-dc-tpl="56"
            x="100"
            y="80"
            width="42"
            height="42"
            rx="6"
            fill="#211f2a"></rect>
        <text
            data-dc-tpl="57"
            x="121"
            y="108"
            text-anchor="middle"
            font-family="Space Grotesk, sans-serif"
            font-weight="800"
            font-size="24"
            fill="#e9e2d3">A</text
        >

        <g data-dc-tpl="58" stroke="#c9bfa8" stroke-width="1.5">
            <line data-dc-tpl="59" x1="160" y1="90" x2="580" y2="90"></line>
            <line data-dc-tpl="60" x1="160" y1="112" x2="580" y2="112"></line>
            <line data-dc-tpl="61" x1="160" y1="134" x2="580" y2="134"></line>
        </g>

        <rect
            data-dc-tpl="62"
            x="166"
            y="164"
            width="348"
            height="96"
            rx="20"
            fill="#17151b"></rect>

        <g data-dc-tpl="63" transform="translate(215,212)">
            <circle data-dc-tpl="64" r="34" fill="url(#hubGmain)"></circle>
            <circle data-dc-tpl="65" r="19" fill="#e9e2d3"></circle>
            <circle data-dc-tpl="66" r="4.5" fill="#17151b"></circle>
            <g
                data-dc-tpl="67"
                stroke="#17151b"
                stroke-width="3.5"
                stroke-linecap="round"
            >
                <path data-dc-tpl="68" d="M0 -13 L0 -6"></path><path
                    data-dc-tpl="69"
                    d="M9 -9 L4.5 -4.5"></path><path
                    data-dc-tpl="70"
                    d="M13 0 L6 0"></path><path
                    data-dc-tpl="71"
                    d="M9 9 L4.5 4.5"></path>
                <path data-dc-tpl="72" d="M0 13 L0 6"></path><path
                    data-dc-tpl="73"
                    d="M-9 9 L-4.5 4.5"></path><path
                    data-dc-tpl="74"
                    d="M-13 0 L-6 0"></path><path
                    data-dc-tpl="75"
                    d="M-9 -9 L-4.5 -4.5"></path>
            </g>
            <animateTransform
                data-dc-tpl="76"
                attributeName="transform"
                type="rotate"
                from="0"
                to="360"
                dur="6s"
                repeatCount="indefinite"
                additive="sum"></animateTransform>
        </g>

        <g data-dc-tpl="77" transform="translate(465,212)">
            <circle data-dc-tpl="78" r="34" fill="url(#hubGmain)"></circle>
            <circle data-dc-tpl="79" r="19" fill="#e9e2d3"></circle>
            <circle data-dc-tpl="80" r="4.5" fill="#17151b"></circle>
            <g
                data-dc-tpl="81"
                stroke="#17151b"
                stroke-width="3.5"
                stroke-linecap="round"
            >
                <path data-dc-tpl="82" d="M0 -13 L0 -6"></path><path
                    data-dc-tpl="83"
                    d="M9 -9 L4.5 -4.5"></path><path
                    data-dc-tpl="84"
                    d="M13 0 L6 0"></path><path
                    data-dc-tpl="85"
                    d="M9 9 L4.5 4.5"></path>
                <path data-dc-tpl="86" d="M0 13 L0 6"></path><path
                    data-dc-tpl="87"
                    d="M-9 9 L-4.5 4.5"></path><path
                    data-dc-tpl="88"
                    d="M-13 0 L-6 0"></path><path
                    data-dc-tpl="89"
                    d="M-9 -9 L-4.5 -4.5"></path>
            </g>
            <animateTransform
                data-dc-tpl="90"
                attributeName="transform"
                type="rotate"
                from="0"
                to="360"
                dur="6s"
                repeatCount="indefinite"
                additive="sum"></animateTransform>
        </g>

        <rect
            data-dc-tpl="91"
            x="257"
            y="202"
            width="166"
            height="20"
            fill="url(#tapeGmain)"></rect>

        <path
            data-dc-tpl="92"
            d="M188 262 L232 300 H448 L492 262 Z"
            fill="none"
            stroke="#0e0c11"
            stroke-opacity=".3"
            stroke-width="2"></path>
        <circle data-dc-tpl="93" cx="278" cy="282" r="12" fill="#17151b"
        ></circle>
        <circle data-dc-tpl="94" cx="402" cy="282" r="12" fill="#17151b"
        ></circle>
        <rect
            data-dc-tpl="95"
            x="316"
            y="274"
            width="14"
            height="14"
            rx="3"
            fill="#17151b"></rect>
        <rect
            data-dc-tpl="96"
            x="350"
            y="274"
            width="14"
            height="14"
            rx="3"
            fill="#17151b"></rect>
    </svg>
</div>
