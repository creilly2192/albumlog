---
const { pathname } = Astro.url;
const isLoggedIn = !!Astro.locals.session;
---

<header class="site-header">
    <div class="container">
        <nav class="site-header__nav">
            <span class="site-name"
                ><a href="/">Album Log.</a>
                <span class="site-name__version">№ 03</span></span
            >
            <ul class="site-header__nav-list">
                <li>
                    <a href="/" class={pathname === "/" ? "active" : ""}
                        >Now Listening</a
                    >
                </li>
                {
                    isLoggedIn && (
                        <li>
                            <a
                                href="/pick-next"
                                class={
                                    pathname === "/pick-next" ? "active" : ""
                                }
                            >
                                Pick Next
                            </a>
                        </li>
                    )
                }
                <li>
                    <a href="/log" class={pathname === "/log" ? "active" : ""}
                        >Log
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</header>
